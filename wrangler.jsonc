{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "voice",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "voice"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHITOWN_KV",
      "id": "1c35f371649941b2a4ba43ee364c89d2"
    }
  ]
}
